# Development Environment Variables
# Copy this to .env for local development

# Database Configuration
DB_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=kexel_db
DB_PORT=5432

DATABASE_DSN="host=postgres user=postgres password=postgres dbname=kexel_db port=5432 sslmode=disable"

# JWT Configuration (use strong secret in production!)
JWT_SECRET=dev_jwt_secret_change_in_production_123456789

# VRChat Map Secret
MAP_SECRET=dev_map_secret

# Logging
LOG_LEVEL=debug

# Frontend
VITE_API_URL=http://localhost:8080

# Caddy (Optional for HTTPS in dev)
DOMAIN=localhost
CLOUDFLARE_API_TOKEN=
ACME_EMAIL=dev@example.com
