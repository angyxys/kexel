# Database Configuration
DB_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=mi_password_seguro
POSTGRES_DB=kexel_db
DB_PORT=5432

DATABASE_DSN="host=$DB_HOST user=$POSTGRES_USER password=$POSTGRES_PASSWORD dbname=$POSTGRES_DB port=$DB_PORT sslmode=disable"

# JWT Configuration
JWT_SECRET=super_secreto_kexel

# VRChat Map Secret (for /vrc endpoints)
MAP_SECRET=your_map_secret_key

# Caddy & HTTPS Configuration (required for Docker Compose)
# Your domain name (e.g., api.example.com)
DOMAIN=api.example.com

# Cloudflare API Token with DNS edit permissions
# Get this from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Email for ACME certificate registration
ACME_EMAIL=your-email@example.com
