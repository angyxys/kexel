{
  email {$ACME_EMAIL}
  acme_dns cloudflare {$CLOUDFLARE_API_TOKEN}
  on_demand_tls {
    ask http://backend:8080/health
  }
}

{$DOMAIN} {
  # Enable automatic HTTPS with Cloudflare DNS validation
  encode gzip

  # API proxy
  handle /api/* {
    reverse_proxy backend:8080 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Host {host}
    }
  }

  # Frontend proxy
  handle {
    reverse_proxy frontend:80 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
      header_up X-Forwarded-Host {host}
    }
  }
}

# HTTP to HTTPS redirect (Caddy handles this automatically)
